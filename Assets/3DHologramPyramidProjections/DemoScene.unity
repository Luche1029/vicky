  m_Text: "\u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u044D\u0442\u043E\u0439
    \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u043F\u0440\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
    \u043B\u044E\u0431\u043E\u0435 \u0432\u0438\u0434\u0435\u043E \u0434\u043B\u044F
    3\u0434-\u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B. \u041D\u0430 \u0441\u0430\u0439\u0442\u0435
    youtube \u0432\u044B \u043D\u0430\u0439\u0434\u0451\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0442\u0430\u043A\u0438\u0445
    \u0432\u0438\u0434\u0435\u043E \u0444\u0430\u0439\u043B\u043E\u0432!\n"
