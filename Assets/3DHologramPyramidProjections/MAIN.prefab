  m_Text: "\u0415\u0441\u043B\u0438 \u043D\u0435\u0442 \u0436\u0435\u043B\u0430\u043D\u0438\u044F
    \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u0443
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0442\u043E \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u043A\u0430\u0437\u0430\u0442\u044C
